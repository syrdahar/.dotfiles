configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "breeze-dark";
    terminal: "alacritty";
    drun-display-format: "{name}";
    display-drun: "󰀻  apps";
    display-run: "󰆍  run";
    display-window: "󰖯  fenêtres";
    window-format: "{c}  ·  {t}";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@theme "~/.config/rofi/neon.rasi"
