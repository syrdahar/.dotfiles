// ──────────────────────────────────────────────────────────────
//  Waybar — Neon Graffiti (barre flottante)
//  Palette : ~/.config/waybar/colors.css
// ──────────────────────────────────────────────────────────────
{
  // Marges / hauteur : mode.jsonc → modes/{islands,floating,docked}.jsonc
  // Bascule : ~/.config/hypr/scripts/rice.sh bar <mode>
  "include": ["~/.config/waybar/mode.jsonc", "~/.config/waybar/stats.jsonc"],
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,

  "modules-left":   ["group/start", "hyprland/window"],
  "modules-center": ["group/center"],
  // modules-right : stats.jsonc → stats/{claude,hw}.jsonc (rice.sh stats toggle)

  // ── Groupes (= une île en mode islands) ────────────────────
  "group/start":   { "orientation": "inherit", "modules": ["custom/launcher", "hyprland/workspaces"] },
  "group/center":  { "orientation": "inherit", "modules": ["clock", "mpris"] },
  "group/hw":      { "orientation": "inherit", "modules": ["cpu", "memory"] },
  "group/system":  { "orientation": "inherit", "modules": ["custom/dictate", "custom/drop", "custom/vpn", "network", "bluetooth", "pulseaudio", "backlight", "battery"] },
  "group/session": { "orientation": "inherit", "modules": ["custom/notification", "custom/power"] },

  // ── Gauche ─────────────────────────────────────────────────
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "pkill rofi || rofi -show drun",
    "on-click-right": "pkill rofi || rofi -show window"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "urgent": "",
      "empty": "",
      "default": ""
    },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "󰖯  {class}",
    "max-length": 28,
    "separate-outputs": true,
    "rewrite": {
      "󰖯  ": "󰍹  bureau",
      "󰖯  Alacritty": "󰆍  alacritty",
      "󰖯  librewolf": "󰈹  librewolf",
      "󰖯  org\\.kde\\.dolphin": "󰉋  dolphin",
      "󰖯  jetbrains-(.*)": "󰅩  $1",
      "󰖯  obsidian": "󰠮  obsidian"
    }
  },

  // ── Centre ─────────────────────────────────────────────────
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "locale": "fr_FR.UTF-8",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#e2b620'><b>{}</b></span>",
        "days":     "<span color='#e6ddf0'>{}</span>",
        "weekdays": "<span color='#29b4d7'><b>{}</b></span>",
        "today":    "<span color='#ff5fb7'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    }
  },

  "mpris": {
    "format": "{status_icon}  {title}",
    "format-paused": "{status_icon}  <i>{title}</i>",
    "status-icons": { "playing": "󰎈", "paused": "󰏤", "stopped": "󰓛" },
    "title-len": 28,
    "tooltip-format": "{player} · {artist} — {title}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  // ── Droite ─────────────────────────────────────────────────
  // ── Claude Code (quotas via cswap) ─────────────────────────
  "custom/claude": {
    "exec": "~/.config/waybar/scripts/claude-usage.py",
    "return-type": "json",
    "interval": 30,
    "signal": 10,
    "escape": false,
    "on-click": "alacritty --class cswap-tui -e cswap tui",
    "on-click-right": "~/.config/waybar/scripts/claude-switch.sh",
    "on-click-middle": "~/.config/hypr/scripts/rice.sh stats toggle"
  },

  // ── Matériel ───────────────────────────────────────────────
  "cpu": {
    "interval": 3,
    "format": "󰍛 {usage}%",
    "states": { "warning": 70, "critical": 90 },
    "tooltip-format": "CPU · {usage}%\nFréquence moy. {avg_frequency} GHz (max {max_frequency})\nCharge {load}",
    "on-click": "alacritty --class btop-float -e btop",
    "on-click-middle": "~/.config/hypr/scripts/rice.sh stats toggle"
  },

  "memory": {
    "interval": 5,
    "format": "󰘚 {used:0.1f} Go",
    "states": { "warning": 70, "critical": 90 },
    "tooltip-format": "RAM · {used:0.1f} / {total:0.1f} Go ({percentage}%)\nSwap · {swapUsed:0.1f} / {swapTotal:0.1f} Go ({swapPercentage}%)",
    "on-click": "alacritty --class btop-float -e btop",
    "on-click-middle": "~/.config/hypr/scripts/rice.sh stats toggle"
  },

  "tray": {
    "icon-size": 13,
    "spacing": 8
  },

  // Dictée (voxtype) : visible seulement pendant l'enregistrement / la transcription
  "custom/dictate": {
    "exec": "~/.local/bin/desktop/desk dictate waybar",
    "return-type": "json",
    "restart-interval": 5,
    "escape": true,
    "on-click": "~/.local/bin/desktop/desk dictate click",
    "on-click-right": "~/.local/bin/desktop/desk dictate cancel"
  },

  // Drop (partage réseau local) : visible seulement quand le serveur tourne
  "custom/drop": {
    "exec": "~/.local/bin/desktop/desk drop waybar",
    "return-type": "json",
    "interval": 15,
    "signal": 11,
    "on-click": "pkill rofi || ~/.local/bin/desktop/desk drop",
    "on-click-right": "~/.local/bin/desktop/desk drop stop",
    "on-click-middle": "~/.local/bin/desktop/desk drop run qr"
  },

  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/nordvpn-status.sh",
    "return-type": "json",
    "interval": 10,
    "on-click": "~/.config/waybar/scripts/nordvpn-toggle.sh",
    "signal": 9
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Déconnecté",
    "on-click": "nm-connection-editor",
    "interval": 5
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Bluetooth : {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager",
    "on-click-right": "~/.config/waybar/scripts/bluetooth-toggle.sh"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%  {format_source}",
    "format-muted": "󰝟 muet  {format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "max-volume": 150,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip-format": "{desc}"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃝", "󰃠"],
    "on-scroll-up": "~/.config/hypr/scripts/osd.sh bri-up",
    "on-scroll-down": "~/.config/hypr/scripts/osd.sh bri-down",
    "tooltip": false
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 plein",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": { "warning": 25, "critical": 12 },
    "tooltip-format": "{timeTo} · {power:.1f} W",
    "interval": 10
  },

  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚<span foreground='#ff5fb7'><sup>●</sup></span>",
      "none": "󰂜",
      "dnd-notification": "󰂛<span foreground='#ff5fb7'><sup>●</sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='#ff5fb7'><sup>●</sup></span>",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛<span foreground='#ff5fb7'><sup>●</sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip": false
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "pkill rofi || ~/.config/waybar/scripts/powermenu.sh"
  }
}
