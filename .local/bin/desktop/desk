#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
#  desk — point d'entrée unique du command center
#   desk <module> [args…]   lance desk-<module> (même dossier)
#   desk                    liste les modules
#  Les modules sont préfixés "desk-" pour ne jamais masquer git, docker, ssh…
# ──────────────────────────────────────────────────────────────
set -euo pipefail
DIR=$(dirname "$(readlink -f "$0")")
lang=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/desk/lang" 2>/dev/null || echo en)

if [[ $# -eq 0 || $1 == -h || $1 == --help ]]; then
    echo "usage: desk <module> [args…]"
    echo "modules :"
    for f in "$DIR"/desk-*; do [[ -x $f ]] && echo "  ${f##*/desk-}"; done
    exit 0
fi

mod=$1; shift
if [[ ! -x $DIR/desk-$mod ]]; then
    [[ $lang == fr ]] && msg="Module inconnu : $mod" || msg="Unknown module: $mod"
    notify-send -a desk -u critical -i dialog-error-symbolic "desk" "$msg" 2>/dev/null || true
    echo "desk: $msg" >&2
    exit 1
fi
exec "$DIR/desk-$mod" "$@"
