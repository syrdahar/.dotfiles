#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
#  desk ssh — connexions depuis ~/.ssh/config (+ Include)
#   desk ssh            choisir un hôte (ou taper user@machine) → terminal ssh
#   desk ssh <hôte>     connexion directe
#  Les motifs (*, !) ne sont pas listés ; les hôtes tapés à la main
#  sont mémorisés (récents en premier).
# ──────────────────────────────────────────────────────────────
source "$(dirname "$(readlink -f "$0")")/lib.sh"
DESK_NAME=ssh
HIST=$DESK_STATE/ssh.hist

config_hosts() {   # Host de ~/.ssh/config et des fichiers Include
    local -a files=(~/.ssh/config) f inc
    [[ -f ~/.ssh/config ]] || return 0
    while read -r inc; do
        for f in ${inc/#\~/$HOME}; do [[ -f $f ]] && files+=("$f"); done
    done < <(awk 'tolower($1) == "include" { for (i = 2; i <= NF; i++) print ($i ~ /^[\/~]/ ? $i : "~/.ssh/" $i) }' ~/.ssh/config)
    awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' "${files[@]}"
}

connect() {
    local h=$1
    { echo "$h"; grep -vxF "$h" "$HIST" 2>/dev/null | head -30; } >"$HIST.tmp" && mv "$HIST.tmp" "$HIST"
    term_run "ssh · $h" "$HOME" ssh "$h"
}

if [[ -n ${1:-} ]]; then connect "$1"; exit 0; fi

hosts=$({ cat "$HIST" 2>/dev/null; config_hosts; } | awk 'NF && !seen[$0]++')
h=$(menu "󰣀  ssh" -mesg "Hôtes de ~/.ssh/config · ou tape user@machine puis Entrée" <<<"$hosts") || exit 0
[[ -n $h ]] && connect "$h"
